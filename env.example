# Copy to .env. Do not commit it (it is in .gitignore).

# Shared secret: you enter the same token in the server under Admin -> System -> Plugins.
# Generate e.g. with: openssl rand -hex 24
PLUGIN_TOKEN=

# Cache for downloaded tracks (older ones are deleted first)
CACHE_LIMIT_GB=20

# Everything else (songs to load ahead, keep songs in the library, yt-dlp updates and branch) is set in the
# server's admin area: System -> Plugins -> gear button of this plugin.

# Name of the server's Docker network (see "docker network ls")
# SERVER_NETWORK=nxtsound_default
